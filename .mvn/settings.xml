<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <mirrors>
    <!-- maven.java.net tidak dapat diakses dari jaringan ini (koneksi ditutup).
         Semua repository eksternal diarahkan ke Maven Central sehingga
         unduhan dependensi di dalam container tidak gagal. -->
    <mirror>
      <id>maven-central-mirror</id>
      <name>Mirror semua repository eksternal ke Maven Central</name>
      <url>https://repo.maven.apache.org/maven2</url>
      <mirrorOf>external:*</mirrorOf>
    </mirror>
  </mirrors>
</settings>
