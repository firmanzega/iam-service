POSTGRES_DB=db_osprey
POSTGRES_USER=user_osprey
POSTGRES_PASSWORD=ganti-dengan-password-anda
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Kunci penanda tangan JWT. Wajib diganti di produksi.
# Minimal 32 byte. Buat dengan: openssl rand -base64 48
JWT_SECRET=ganti-dengan-kunci-acak-minimal-32-byte

# Origin frontend yang diizinkan memanggil API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
