# Contoh konfigurasi lokal.
#
# Salin berkas ini menjadi .env, lalu isi nilainya.
# Berkas .env tidak boleh masuk ke git. Berkas ini boleh, karena isinya
# hanya placeholder.

# ---------------------------------------------------------------- database
POSTGRES_DB=db_osprey
POSTGRES_USER=user_osprey
POSTGRES_PASSWORD=ganti-dengan-password-anda
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ---------------------------------------------------------------- token JWT
# Kunci penanda tangan token. Wajib diganti di produksi.
# Minimal 32 byte. Buat dengan: openssl rand -base64 48
JWT_SECRET=ganti-dengan-kunci-acak-minimal-32-byte

# ---------------------------------------------------------------- CORS
# Origin frontend yang diizinkan memanggil API. Pisahkan dengan koma.
# Jangan memakai tanda bintang, karena kredensial ikut dikirim.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------- bootstrap dev
# Hanya dipakai oleh profil dev. Mengganti kata sandi administrator dev.
IAM_DEV_ADMIN_USERNAME=admin
IAM_DEV_ADMIN_EMAIL=admin@iam.local
IAM_DEV_ADMIN_PASSWORD=Admin1234
