<?xml version="1.0" encoding="UTF-8"?>
<!--
    Pengecualian SpotBugs yang disetujui untuk ambang Medium.

    Prinsipnya: pengecualian harus menyebut kelas dan pola persis, bukan
    mematikan pola secara global. Kalau nanti muncul kelas baru yang
    membocorkan representasi internal, temuan itu tetap dilaporkan dan harus
    ditinjau, bukan otomatis lolos.

    Ada dua kelompok pengecualian:

    1. Injeksi dependensi lewat konstruktor pada komponen Spring.
       SpotBugs melihat referensi ke objek yang bisa berubah, tetapi objek
       yang disuntikkan adalah bean singleton yang dikelola container dan
       tidak diubah oleh kelas penerima. Menyalinnya justru salah, karena
       salinan itu memutus hal yang memang harus dipakai bersama.

    2. Grafik objek domain dan JPA yang sengaja dibagi.
       Entitas JPA wajib memberi akses ke relasinya supaya Hibernate bisa
       mengelola siklus hidup relasi. RefreshToken.getUser() juga sengaja
       mengembalikan pengguna yang sama, karena use case autentikasi memang
       perlu mengubah keadaan pengguna tersebut di dalam transaksi yang sama.
-->
<FindBugsFilter>

    <!-- Kelompok 1: injeksi dependensi pada komponen Spring. -->
    <Match>
        <Class name="id.osprey.iamservice.application.logging.LoggingServiceImpl"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="id.osprey.iamservice.adapter.rest.RoleController"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
