<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
    Aturan Checkstyle sengaja dimulai dari hal yang tidak bisa diperdebatkan:
    impor yang tidak dipakai, impor ganda, dan karakter yang merusak berkas.

    Gaya penulisan seperti panjang baris atau urutan anggota kelas tidak
    dimasukkan lebih dulu, karena aturan seperti itu harus disepakati bersama
    sebelum diberlakukan. Menambahkan aturan yang belum disepakati hanya akan
    menghasilkan ratusan temuan yang akhirnya diabaikan.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>

    <module name="FileTabCharacter"/>
    <module name="NewlineAtEndOfFile"/>

    <!-- Aturan gaya yang disepakati bersama. Panjang 120 dipilih karena
         kode yang lebih panjang biasanya sulit dibaca berdampingan saat
         review, sementara 100 terlalu sempit untuk nama kelas yang sudah
         panjang. Impor dikecualikan karena barisnya tidak bisa dipotong
         tanpa merusak sintaksis. -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^import .*"/>
    </module>

    <module name="TreeWalker">
        <module name="AvoidStarImport"/>
        <module name="IllegalImport"/>
        <module name="RedundantImport"/>
        <module name="UnusedImports">
            <property name="processJavadoc" value="true"/>
        </module>
        <module name="EqualsHashCode"/>
        <module name="FallThrough"/>
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="expected|ignored"/>
        </module>

        <!-- Kurung kurawal wajib ada meskipun isinya satu pernyataan. Ini
             mencegah bug akibat penambahan baris kedua yang tidak sengaja
             berada di luar blok. -->
        <module name="NeedBraces"/>

        <!-- Satu pernyataan per baris memudahkan pembaca dan alat diff
             menunjukkan perubahan secara tepat. -->
        <module name="OneStatementPerLine"/>

        <!-- Urutan modifier yang seragam membuat deklarasi bisa dipindai
             dengan cepat, misalnya mencari semua method public static. -->
        <module name="ModifierOrder"/>
    </module>
</module>
